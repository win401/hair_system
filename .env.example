# Keep the default demo deterministic until the real adapter is implemented.
HAIR_GENERATOR_PROVIDER=mock

# Gemini image generation currently requires paid API access. Enable only after
# confirming billing and per-image cost for the selected model.
# HAIR_GENERATOR_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
HAIR_COMPOSITOR_PROVIDER=python
HAIR_PYTHON_BIN=python3
# Local default. Set this to the Python executable available in deployment.
# HAIR_PYTHON_BIN=.venv/bin/python

# Production (Vercel) mode: "python" above runs a local subprocess, which
# Vercel's Node.js functions cannot do. Deploy python/server.py (see the
# repo-root Dockerfile) to its own service (Render/Fly.io/etc.) and switch to:
# HAIR_COMPOSITOR_PROVIDER=http
# HAIR_COMPOSITOR_SERVICE_URL=https://your-compositor-service.example.com
# HAIR_COMPOSITOR_API_KEY=
# (HAIR_COMPOSITOR_API_KEY must match the same env var set on that service.)

# Trend curation is free and deterministic. Set to gemini only when you want
# a paid, personalised text recommendation using the same GEMINI_API_KEY.
HAIR_RECOMMENDER_PROVIDER=trend-curation
# HAIR_RECOMMENDER_PROVIDER=gemini
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# Server-only Supabase credentials. Do not prefix these names with NEXT_PUBLIC.
# Use the project's URL and its secret key (never the browser publishable key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
